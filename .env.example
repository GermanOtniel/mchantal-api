NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Activar SSL para Neon/cloud Postgres (true|false). En local dejar vacío/false.
DB_SSL=false

# Origen(es) permitido(s) para CORS. Vacío = reflejar cualquier origen (dev).
# En producción: https://tu-front.vercel.app  (varios separados por coma)
CORS_ORIGIN=

JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=7d
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_TOKEN_MINUTES=60

FRONTEND_PASSWORD_RESET_URL=https://tu-front.com/reset-password

RESEND_EMAIL_API_KEY=
MAIL_FROM=onboarding@resend.dev

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE_E164=5212345678900

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=