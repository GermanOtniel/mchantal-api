NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_TOKEN_MINUTES=60

FRONTEND_PASSWORD_RESET_URL=https://tu-front.com/reset-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

WHATSAPP_BUSINESS_PHONE=52155XXXXXXXX
PUBLIC_CAPTURE_RATE_LIMIT=30
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

MAX_ANALYTICS_RANGE_DAYS=90

# Redis pub/sub para eventos SSE en tiempo real (opcional; requerido con múltiples réplicas del API)
# REDIS_URL=redis://localhost:6379
